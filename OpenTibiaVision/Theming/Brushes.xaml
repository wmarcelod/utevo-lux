<!--
  Named frozen brushes derived from the DesignTokens palette. po:Freeze="True" makes each
  brush immutable => cross-thread-safe, GPU-cacheable, no clone-on-render (optimization
  principle 2). Everything that paints reads THESE, never a raw color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Self-contained: merge the tokens so StaticResource Color.* resolves even when this
         dictionary is realized lazily / in isolation (WPF resolves StaticResource against the
         dictionary's own MergedDictionaries). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Theming/DesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BackgroundBrush"   Color="{StaticResource Color.Background}"   po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource Color.Surface}"      po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"   Color="{StaticResource Color.SurfaceAlt}"   po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBrush"         Color="{StaticResource Color.Card}"         po:Freeze="True"/>
    <SolidColorBrush x:Key="CardHoverBrush"    Color="{StaticResource Color.CardHover}"    po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource Color.Border}"       po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Color.BorderStrong}" po:Freeze="True"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource Color.TextPrimary}"   po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource Color.TextMuted}"     po:Freeze="True"/>

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource Color.Accent}"        po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Color.AccentPressed}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource Color.AccentSoft}"    po:Freeze="True"/>

    <SolidColorBrush x:Key="DangerBrush"  Color="{StaticResource Color.Danger}"  po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning}" po:Freeze="True"/>

    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Color.Overlay}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrimBrush"   Color="{StaticResource Color.ScrimTop}" po:Freeze="True"/>

</ResourceDictionary>
