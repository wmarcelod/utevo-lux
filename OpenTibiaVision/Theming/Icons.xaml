<!--
  Vector Path icon geometries (24x24 design grid). Consumed by <Path Data="{StaticResource ...}"
  Stretch="Uniform"/> so they stay crisp at any UI scale. Frozen for GPU caching.
  Feature modules expose their own Geometry (IFeatureModule.Icon); these are the shared set.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Mirror: two overlapping rounded frames -->
    <Geometry x:Key="Icon.Mirror" po:Freeze="True">M4,4 H14 V14 H4 Z M10,10 H20 V20 H10 Z</Geometry>

    <!-- Plus -->
    <Geometry x:Key="Icon.Add" po:Freeze="True">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</Geometry>

    <!-- Gear (settings) -->
    <Geometry x:Key="Icon.Settings" po:Freeze="True">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M12,10.5 A1.5,1.5 0 1 1 12,13.5 A1.5,1.5 0 1 1 12,10.5 Z M10.7,2 H13.3 L13.8,4.3 L15.6,5.1 L17.7,4 L19.5,5.8 L18.4,7.9 L19.2,9.7 L21.5,10.2 V12.8 L19.2,13.3 L18.4,15.1 L19.5,17.2 L17.7,19 L15.6,17.9 L13.8,18.7 L13.3,21 H10.7 L10.2,18.7 L8.4,17.9 L6.3,19 L4.5,17.2 L5.6,15.1 L4.8,13.3 L2.5,12.8 V10.2 L4.8,9.7 L5.6,7.9 L4.5,5.8 L6.3,4 L8.4,5.1 L10.2,4.3 Z</Geometry>

    <!-- Lock -->
    <Geometry x:Key="Icon.Lock" po:Freeze="True">M7,10 V7 A5,5 0 0 1 17,7 V10 H18.5 V21 H5.5 V10 Z M9,10 H15 V7 A3,3 0 0 0 9,7 Z</Geometry>

    <!-- Unlock -->
    <Geometry x:Key="Icon.Unlock" po:Freeze="True">M7,10 V7 A5,5 0 0 1 16.8,5.5 H14.7 A3,3 0 0 0 9,7 V10 H18.5 V21 H5.5 V10 Z</Geometry>

    <!-- Eye -->
    <Geometry x:Key="Icon.Eye" po:Freeze="True">M12,5 C6,5 2,12 2,12 C2,12 6,19 12,19 C18,19 22,12 22,12 C22,12 18,5 12,5 Z M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 Z</Geometry>

    <!-- Eye off -->
    <Geometry x:Key="Icon.EyeOff" po:Freeze="True">M3,4 L20,21 L18.6,22.4 L15.7,19.5 C14.5,19.8 13.3,20 12,20 C6,20 2,12 2,12 C2,12 3.4,9.4 6,7.3 L1.6,3 Z M12,8 A4,4 0 0 1 16,12 L13,9 C12.7,8.9 12.4,8.9 12,8.9 Z M12,5 C18,5 22,12 22,12 C22,12 20.9,14.1 18.7,16 L15.8,13.1 A4,4 0 0 0 10.9,8.2 L8.9,6.2 C9.9,5.5 10.9,5 12,5 Z</Geometry>

    <!-- Trash -->
    <Geometry x:Key="Icon.Trash" po:Freeze="True">M9,3 H15 L16,5 H20 V7 H4 V5 H8 Z M5.5,8 H18.5 L17.5,21 H6.5 Z M9,10 V19 H10.5 V10 Z M13.5,10 V19 H15 V10 Z</Geometry>

    <!-- Close (X) -->
    <Geometry x:Key="Icon.Close" po:Freeze="True">M6,7.4 L7.4,6 L12,10.6 L16.6,6 L18,7.4 L13.4,12 L18,16.6 L16.6,18 L12,13.4 L7.4,18 L6,16.6 L10.6,12 Z</Geometry>

    <!-- Minimize -->
    <Geometry x:Key="Icon.Minimize" po:Freeze="True">M5,17 H19 V19 H5 Z</Geometry>

    <!-- Target / detect -->
    <Geometry x:Key="Icon.Target" po:Freeze="True">M11,2 H13 V4.1 A8,8 0 0 1 19.9,11 H22 V13 H19.9 A8,8 0 0 1 13,19.9 V22 H11 V19.9 A8,8 0 0 1 4.1,13 H2 V11 H4.1 A8,8 0 0 1 11,4.1 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z</Geometry>

    <!-- Refresh -->
    <Geometry x:Key="Icon.Refresh" po:Freeze="True">M12,4 A8,8 0 1 0 20,12 H17.8 A5.8,5.8 0 1 1 12,6.2 V9 L17,5 L12,1 Z</Geometry>

</ResourceDictionary>
