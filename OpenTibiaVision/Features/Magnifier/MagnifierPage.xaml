<UserControl x:Class="OpenTibiaVision.Features.Magnifier.MagnifierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <!-- Follow-cursor lens -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Lupa (segue o cursor)" Style="{StaticResource Text.Title}"
                               FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FollowStatus}" Style="{StaticResource Text.Secondary}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hold gesture -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ativar (segurar):"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  ItemsSource="{Binding HoldGestureOptions}"
                                  SelectedItem="{Binding SelectedHoldGesture, Mode=TwoWay}"/>

                        <!-- Shape -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Forma:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  ItemsSource="{Binding ShapeOptions}"
                                  SelectedItem="{Binding SelectedFollowShape, Mode=TwoWay}"/>

                        <!-- Size -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tamanho:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="120" Maximum="520" TickFrequency="20" IsSnapToTickEnabled="True"
                                Value="{Binding LensSize, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LensSizeText}"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="8,4,0,4"/>

                        <!-- Default zoom -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Zoom padrao:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="{Binding ZoomMin}" Maximum="{Binding ZoomMax}"
                                TickFrequency="{Binding ZoomStep}" IsSnapToTickEnabled="True"
                                Value="{Binding DefaultZoom, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DefaultZoomText}"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="8,4,0,4"/>

                        <!-- Opacity -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Opacidade:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding FollowOpacityPercent, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding FollowOpacityText}"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="8,4,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Fixed-crop loupe -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Lupa fixa (recorte)" Style="{StaticResource Text.Title}"
                               FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="Amplia um recorte fixo da janela fonte. Arraste para posicionar quando destravada."
                               Style="{StaticResource Text.Secondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Source picker -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fonte:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Atualizar" Margin="8,0,0,0"
                                Command="{Binding RefreshSourcesCommand}"/>
                        <Button Grid.Column="3" Content="Detectar Tibia" Margin="8,0,0,0"
                                Command="{Binding DetectTibiaCommand}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Forma:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  ItemsSource="{Binding ShapeOptions}"
                                  SelectedItem="{Binding SelectedLoupeShape, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Zoom:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="{Binding ZoomMin}" Maximum="{Binding ZoomMax}"
                                TickFrequency="{Binding ZoomStep}" IsSnapToTickEnabled="True"
                                Value="{Binding LoupeZoom, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LoupeZoomText}"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="8,4,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Centro X:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="0" Maximum="1" TickFrequency="0.02" IsSnapToTickEnabled="True"
                                Value="{Binding LoupeCenterX, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Centro Y:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="0" Maximum="1" TickFrequency="0.02" IsSnapToTickEnabled="True"
                                Value="{Binding LoupeCenterY, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Opacidade:"
                                   VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding LoupeOpacityPercent, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LoupeOpacityText}"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="8,4,0,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button MinWidth="96" Content="{Binding LoupeVisibleButtonText}"
                                Style="{StaticResource Button.Accent}"
                                Command="{Binding ShowHideLoupeCommand}"/>
                        <Button MinWidth="96" Margin="8,0,0,0" Content="{Binding LoupeLockButtonText}"
                                Command="{Binding ToggleLockLoupeCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}"
                               FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
