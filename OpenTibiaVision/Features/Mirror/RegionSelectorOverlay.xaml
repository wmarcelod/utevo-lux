<Window x:Class="OpenTibiaVision.Features.Mirror.RegionSelectorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar regiao"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33101820"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross">

    <Grid>
        <Canvas x:Name="RootCanvas">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2"
                       Fill="{StaticResource AccentSoftBrush}"/>
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,24,0,0"
                Background="{StaticResource OverlayBrush}"
                CornerRadius="6"
                Padding="16,10"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"
                       Text="Arraste para selecionar a regiao a espelhar (area do jogo).&#x0a;Soltar confirma  -  Clique-direito, botao Cancelar ou Esc cancela"/>
        </Border>

        <Button x:Name="CancelButton"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,24,24,0"
                Content="Cancelar"
                Foreground="White"
                Background="#CC202832"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Padding="16,8"
                FontSize="14"
                Cursor="Arrow"
                Click="CancelButton_Click"/>
    </Grid>
</Window>
