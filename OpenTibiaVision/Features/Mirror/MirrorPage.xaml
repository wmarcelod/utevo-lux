<UserControl x:Class="OpenTibiaVision.Features.Mirror.MirrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source picker -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Fonte:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="Atualizar" Margin="8,0,0,0" Command="{Binding RefreshSourcesCommand}"/>
            <Button Grid.Column="3" Content="Detectar Tibia" Margin="8,0,0,0" Command="{Binding DetectTibiaCommand}"/>
        </Grid>

        <!-- Add region -->
        <Button Grid.Row="1"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Padding="14,7"
                Style="{StaticResource Button.Accent}"
                Command="{Binding AddRegionCommand}">
            <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF08131C"
                      VerticalAlignment="Center" Data="{StaticResource Icon.Add}"/>
                <TextBlock Text="Adicionar Regiao" Margin="8,0,0,0" Foreground="#FF08131C"/>
            </StackPanel>
        </Button>

        <!-- Region list -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,6" Padding="12"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DisplayInfo}"
                                                   Style="{StaticResource Text.Secondary}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding VisibleButtonText}"
                                                MinWidth="76" Margin="4,0,0,0"
                                                Command="{Binding ToggleVisibleCommand}"/>
                                        <Button Content="{Binding LockButtonText}"
                                                MinWidth="76" Margin="4,0,0,0"
                                                Command="{Binding ToggleLockCommand}"/>
                                        <Button Content="Remover"
                                                MinWidth="76" Margin="4,0,0,0"
                                                Command="{Binding RemoveCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   Text="{Binding Status}"
                   Style="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</UserControl>
