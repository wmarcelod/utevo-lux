<UserControl x:Class="OpenTibiaVision.Shell.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <!-- Profile -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Perfil" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="Conjuntos de configuracoes independentes (ex.: por personagem)."
                               Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ProfileCombo" Width="220" SelectionChanged="OnProfileChanged"/>
                        <Button x:Name="NewProfileButton" Content="Novo" Margin="8,0,0,0" Click="OnNewProfile"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Inicializacao" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10"/>
                    <CheckBox x:Name="StartupCheck"
                              Content="Iniciar com o Windows (minimizado na bandeja)"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Click="OnStartupToggle"/>
                </StackPanel>
            </Border>

            <!-- UI scale -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Escala da interface" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="Atalhos: Ctrl +  /  Ctrl -  /  Ctrl 0 (redefinir)."
                               Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Width="40" Click="OnScaleDown"/>
                        <TextBlock x:Name="ScaleLabel" Text="100%" Width="70" TextAlignment="Center"
                                   VerticalAlignment="Center" FontSize="14"/>
                        <Button Content="+" Width="40" Click="OnScaleUp"/>
                        <Button Content="Redefinir" Margin="12,0,0,0" Click="OnScaleReset"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Armazenamento" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StoragePathLabel" Style="{StaticResource Text.Secondary}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
