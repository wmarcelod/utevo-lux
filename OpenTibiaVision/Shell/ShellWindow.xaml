<Window x:Class="OpenTibiaVision.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenTibiaVision"
        Width="900" Height="580"
        MinWidth="720" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- WindowChrome gives edge-resize while we draw all chrome ourselves. CaptionHeight=0:
         the title bar drag is handled manually so buttons live in that strip. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- RootChrome: the rounded, painted surface. LayoutTransform on ScaleRoot = UI scale. -->
    <Border x:Name="RootChrome"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            SizeChanged="OnRootSizeChanged">
        <Grid x:Name="ScaleRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10,0,0,10">
                <DockPanel>
                    <!-- Brand row (also a drag handle) -->
                    <Border DockPanel.Dock="Top" Height="52" Padding="16,0"
                            Background="Transparent"
                            MouseLeftButtonDown="OnTitleBarDrag">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{StaticResource AccentBrush}"
                                  Data="{StaticResource Icon.Mirror}"/>
                            <TextBlock Text="OpenTibiaVision" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav rail -->
                    <ListBox x:Name="NavList"
                             DockPanel.Dock="Top"
                             Margin="8,8,8,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Height="40">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle x:Name="ActiveBar" Grid.Column="0"
                                                               Width="3" RadiusX="2" RadiusY="2"
                                                               Fill="{StaticResource AccentBrush}"
                                                               Visibility="Collapsed"/>
                                                    <Path x:Name="Glyph" Grid.Column="1"
                                                          Width="18" Height="18" Margin="12,0,0,0"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource TextSecondaryBrush}"
                                                          Data="{Binding Icon}"/>
                                                    <TextBlock x:Name="Label" Grid.Column="2"
                                                               Text="{Binding Title}"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBrush}"/>
                                                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Content column ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar strip -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                    <TextBlock Text="{Binding ActiveTitle}"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource Button.Icon}" Click="OnMinimize" ToolTip="Minimizar para a bandeja">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Data="{StaticResource Icon.Minimize}"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Click="OnClose" ToolTip="Fechar">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Data="{StaticResource Icon.Close}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Page host: all pages live here, built once, Visibility-toggled -->
                <Grid Grid.Row="1" x:Name="PageHost" Margin="20,4,20,20"/>
            </Grid>

            <!-- ===== Startup progress overlay (spans both columns) ===== -->
            <Border x:Name="ProgressOverlay" Grid.ColumnSpan="2"
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                    <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
                          Fill="{StaticResource AccentBrush}"
                          Data="{StaticResource Icon.Mirror}"/>
                    <TextBlock Text="OpenTibiaVision"
                               HorizontalAlignment="Center" Margin="0,14,0,4"
                               FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="StartupBar" Height="3" Width="200" IsIndeterminate="True"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0" Margin="0,10,0,8"/>
                    <TextBlock x:Name="StartupStatus" Text="Iniciando..."
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Secondary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
