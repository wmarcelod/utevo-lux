<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows: the WindowsDesktop 8.0.22 targeting pack is installed on this
         machine. If that pack were missing, switch this to net10.0-windows (SDK 10 has it). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenTibiaVision</RootNamespace>
    <AssemblyName>OpenTibiaVision</AssemblyName>
    <!-- PerMonitorV2 DPI awareness declared in app.manifest so GetDpiForWindow and the
         DWM thumbnail rect math stay consistent across mixed-DPI monitors. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
