<Window x:Class="OpenTibiaVision.Views.RegionSelectorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar regiao"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33101820"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross">

    <Grid>
        <Canvas x:Name="RootCanvas">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FF3FA9F5"
                       StrokeThickness="2"
                       Fill="#553FA9F5" />
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,24,0,0"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,10"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"
                       Text="Arraste para selecionar a regiao a espelhar.&#x0a;Enter/soltar confirma  -  Esc cancela" />
        </Border>
    </Grid>
</Window>
