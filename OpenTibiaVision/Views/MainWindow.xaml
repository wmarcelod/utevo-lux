<Window x:Class="OpenTibiaVision.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTibiaVision"
        Width="720" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F27">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#FFE6E9EF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source picker -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Fonte:" Style="{StaticResource Label}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Atualizar" Command="{Binding RefreshSourcesCommand}" />
            <Button Grid.Column="3" Content="Detectar Tibia" Command="{Binding DetectTibiaCommand}" />
        </Grid>

        <!-- Add region -->
        <Button Grid.Row="1"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Padding="14,7"
                Content="+ Adicionar Regiao"
                Command="{Binding AddRegionCommand}" />

        <!-- Region list -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                BorderBrush="#FF333A47"
                BorderThickness="1"
                Background="#FF232833"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,6"
                                    Padding="10"
                                    Background="#FF2C3340"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#FFF3F5F9"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DisplayInfo}"
                                                   Foreground="#FF9AA4B3"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding VisibleButtonText}"
                                                Command="{Binding ToggleVisibleCommand}" />
                                        <Button Content="{Binding LockButtonText}"
                                                Command="{Binding ToggleLockCommand}" />
                                        <Button Content="Remover"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}"
                       Foreground="#FF9AA4B3"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
