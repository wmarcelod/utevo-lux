<Window x:Class="OpenTibiaVision.Views.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenTibiaVision - Espelho"
        Width="400" Height="300"
        MinWidth="80" MinHeight="60"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#FF101010">

    <!-- WindowChrome gives us edge-resize grips without a caption/frame while keeping
         AllowsTransparency=False. AllowsTransparency=False is REQUIRED: DWM live
         thumbnails do not composite into WPF per-pixel-alpha (layered) windows. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- RootBorder is the thin visible drag border (hidden when locked). The DWM
         thumbnail is composited into Host, inset by this border. -->
    <Border x:Name="RootBorder"
            BorderBrush="#FF3FA9F5"
            BorderThickness="2"
            Background="#FF101010"
            MouseLeftButtonDown="OnBodyMouseLeftButtonDown">
        <Grid x:Name="Host" Background="Black" />
    </Border>
</Window>
