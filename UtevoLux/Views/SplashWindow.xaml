<!--
  Startup splash. Mirrors the original TibiaVision splash (WindowReplicaApp.App.CreateSplashWindow):
  a rounded, glowing card with the logo, the wordmark, a "loading" line, three pulsing dots and a
  multilingual greeting. Recoloured to the fork's BLUE accent; the logo raster is the original asset.
  Shown for ~2s by App, then faded out onto the shell.
-->
<Window x:Class="UtevoLux.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UtevoLux"
        Width="420" Height="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Third greeting keeps the original's green accent. -->
        <SolidColorBrush x:Key="GreetGreen" Color="#FF4AC83C"/>
    </Window.Resources>

    <Grid Margin="30">
        <Border CornerRadius="28"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="#B43FA9F5"
                BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="#FF3FA9F5" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0"
                       Source="/Assets/splash_logo.png"
                       Width="120" Height="120"
                       VerticalAlignment="Bottom"
                       Margin="0,30,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="24" Color="#FF3FA9F5" Opacity="0.4"/>
                    </Image.Effect>
                </Image>

                <!-- Wordmark -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="28" FontWeight="Bold">
                    <Run Text="OpenTibia" Foreground="{StaticResource AccentBrush}"/><Run Text="Vision" Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>

                <!-- Loading line -->
                <TextBlock Grid.Row="2"
                           Text="Carregando..."
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontFamily="{StaticResource Font.App}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Pulsing dots -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3,0" Opacity="0.3"/>
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3,0" Opacity="0.3"/>
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3,0" Opacity="0.3"/>
                </StackPanel>

                <!-- Multilingual greeting -->
                <TextBlock Grid.Row="5"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           FontFamily="{StaticResource Font.App}"
                           FontSize="12">
                    <Run Text="Hello!" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="   "/><Run Text="Cze&#347;&#263;!" Foreground="{StaticResource AccentBrush}"/><Run Text="   "/><Run Text="Ol&#225;!" Foreground="{StaticResource GreetGreen}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Dot1"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.3" To="1.0" Duration="0:0:0.3"
                                     AutoReverse="True" BeginTime="0:0:0"/>
                    <DoubleAnimation Storyboard.TargetName="Dot2"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.3" To="1.0" Duration="0:0:0.3"
                                     AutoReverse="True" BeginTime="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Dot3"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.3" To="1.0" Duration="0:0:0.3"
                                     AutoReverse="True" BeginTime="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
