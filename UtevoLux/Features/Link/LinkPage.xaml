<UserControl x:Class="UtevoLux.Features.Link.LinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:link="clr-namespace:UtevoLux.Features.Link">
    <UserControl.Resources>
        <link:PartyStatusToBrushConverter x:Key="StatusToBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="TibiaVision Link" Style="{StaticResource Text.Title}"/>
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Junte-se a uma party para compartilhar seu status em tempo real. O relay do TibiaVision Link deve estar online."/>
        </StackPanel>

        <!-- Body: setup OR party (toggled in code-behind) -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>

                    <!-- ===== Setup panel (not in a party) ===== -->
                    <StackPanel x:Name="SetupPanel">
                        <TextBlock Text="Nome de exibicao" Style="{StaticResource Text.Secondary}" FontSize="12"/>
                        <TextBox x:Name="DisplayNameTextBox" Margin="0,4,0,0" MaxLength="24"/>

                        <TextBlock Text="Criar uma party" FontWeight="SemiBold" Margin="0,16,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duracao" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,8,0"/>
                            <ComboBox x:Name="DurationComboBox" Grid.Column="1" VerticalContentAlignment="Center">
                                <ComboBoxItem Tag="60">1 hora</ComboBoxItem>
                                <ComboBoxItem Tag="120" IsSelected="True">2 horas</ComboBoxItem>
                                <ComboBoxItem Tag="240">4 horas</ComboBoxItem>
                                <ComboBoxItem Tag="480">8 horas</ComboBoxItem>
                            </ComboBox>
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,7"
                                    Style="{StaticResource Button.Accent}"
                                    Click="CreatePartyButton_Click">
                                <TextBlock Text="Criar party" Foreground="#FF08131C"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Ou entrar com um codigo" FontWeight="SemiBold" Margin="0,16,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodeTextBox" Grid.Column="0"
                                     CharacterCasing="Upper" MaxLength="12"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Entrar" Margin="8,0,0,0" Padding="14,7"
                                    Click="JoinPartyButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Party panel (in a party) ===== -->
                    <StackPanel x:Name="PartyPanel" Visibility="Collapsed">
                        <TextBlock Text="Codigo da party" Style="{StaticResource Text.Secondary}" FontSize="12"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                                    CornerRadius="4" Padding="12,8">
                                <TextBlock x:Name="PartyCodeText" FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas, monospace"/>
                            </Border>
                            <Button Grid.Column="1" Content="Copiar" Margin="8,0,0,0" Padding="14,7"
                                    Click="CopyCodeButton_Click"/>
                        </Grid>

                        <TextBlock Text="Membros" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ItemsControl x:Name="MembersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10,8"
                                            Background="{StaticResource CardBrush}" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Sair da party" Margin="0,14,0,0" Padding="14,7"
                                HorizontalAlignment="Left" Click="LeavePartyButton_Click"/>
                    </StackPanel>

                    <!-- Status line -->
                    <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12" Visibility="Collapsed"/>

                    <!-- ===== Overlay settings ===== -->
                    <Border Height="1" Margin="0,18,0,12" Background="{StaticResource BorderBrush}"/>
                    <TextBlock Text="Overlay de status" FontWeight="SemiBold"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LockToggleButton" Grid.Column="0" Padding="10,7"
                                Click="LockToggle_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="LockToggleIcon" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Data="{StaticResource Icon.Lock}"/>
                                <TextBlock x:Name="LockToggleText" Text="Travado" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Style="{StaticResource Text.Secondary}" FontSize="11" TextWrapping="Wrap"
                                   Text="Destrave para mover o overlay. Travado ele fica click-through."/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Escala" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Secondary}" FontSize="12"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="ScaleSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                   Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:0%}}"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Opacidade" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Secondary}" FontSize="12"/>
                        <Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0.15" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                   Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:0%}}"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Som de queda" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Secondary}" FontSize="12"/>
                        <Slider x:Name="DisconnectVolumeSlider" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                ValueChanged="DisconnectVolumeSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                   Text="{Binding ElementName=DisconnectVolumeSlider, Path=Value, StringFormat={}{0:0%}}"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer hint -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0"
                   Style="{StaticResource Text.Secondary}" FontSize="11"
                   Text="O overlay aparece sobre o jogo quando voce esta em uma party."/>
    </Grid>
</UserControl>
