<UserControl x:Class="UtevoLux.Features.Audio.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page-local input styles so text boxes / check boxes read correctly on the dark cards.
         Self-contained: does not touch shared theming. -->
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Master controls -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Volume geral" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                        VerticalAlignment="Center"
                        Value="{Binding MasterVolumePercent, Mode=TwoWay}"
                        TickFrequency="10" IsSnapToTickEnabled="False"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource Text.Secondary}"
                           Text="{Binding BackendName, StringFormat=Backend de audio: {0}}"/>

                <Button Grid.Column="3" MinWidth="120" Margin="8,0,0,0"
                        Content="{Binding MuteButtonText}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="Silenciar / reativar (Ctrl+Alt+M)"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Dispensar alertas" Margin="0,0,8,0"
                            Command="{Binding DismissAlertsCommand}"
                            ToolTip="Ctrl+Alt+D"/>
                    <Button Content="Parar tudo"
                            Command="{Binding StopAllCommand}"
                            ToolTip="Ctrl+Alt+S"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add timer -->
        <Button Grid.Row="1" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7"
                Style="{StaticResource Button.Accent}" Command="{Binding AddTimerCommand}">
            <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF08131C"
                      VerticalAlignment="Center" Data="{StaticResource Icon.Add}"/>
                <TextBlock Text="Adicionar Timer" Margin="8,0,0,0" Foreground="#FF08131C"/>
            </StackPanel>
        </Button>

        <!-- Content: timers (left) + sounds (right) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Timers -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Timers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8,6" Padding="12"
                                        Background="{StaticResource CardBrush}" CornerRadius="6">
                                    <StackPanel>

                                        <!-- Row 1: name + remaining -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontFamily="Consolas" FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding RemainingText}"/>
                                        </Grid>

                                        <!-- Row 2: durations + hotkey -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Durações (s):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding DurationsText}"
                                                     ToolTip="Segundos separados por vírgula. Um toque arma todas (fan-out)."/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0" Text="Tecla:"/>
                                            <Border Grid.Column="3" Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,4" VerticalAlignment="Center" MinWidth="90">
                                                <TextBlock Text="{Binding HotkeyText}" TextAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="4" Content="Definir" Margin="6,0,0,0"
                                                    Command="{Binding SetHotkeyCommand}"/>
                                            <Button Grid.Column="5" Content="Limpar" Margin="6,0,0,0"
                                                    Command="{Binding ClearHotkeyCommand}"/>
                                        </Grid>

                                        <!-- Row 3: sound + loop + volume -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Som:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Sounds}"
                                                      SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"/>
                                            <CheckBox Grid.Column="2" Content="Loop" Margin="12,0,12,0"
                                                      IsChecked="{Binding LoopSound}"/>
                                            <TextBlock Grid.Column="3" Text="Vol:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="4" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    Value="{Binding VolumePercent, Mode=TwoWay}"/>
                                        </Grid>

                                        <!-- Row 4: alert + bar -->
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox Content="Alerta visual" IsChecked="{Binding AlertEnabled}"/>
                                            <CheckBox Content="Ficar até tecla" IsChecked="{Binding AlertStayUntilHotkey}"/>
                                            <Button Content="Posicionar alerta" Margin="0,0,14,0"
                                                    Command="{Binding PlaceAlertCommand}"/>
                                            <CheckBox Content="Barra de contagem" IsChecked="{Binding BarEnabled}"/>
                                            <Button Content="Posicionar barra"
                                                    Command="{Binding PlaceBarCommand}"/>
                                        </WrapPanel>

                                        <!-- Row 5: actions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                            <Button Content="Iniciar / Reiniciar" MinWidth="120" Margin="0,0,8,0"
                                                    Style="{StaticResource Button.Accent}"
                                                    Command="{Binding TriggerCommand}"/>
                                            <Button Content="Parar" MinWidth="72" Margin="0,0,8,0"
                                                    Command="{Binding StopCommand}"/>
                                            <Button Content="Remover" MinWidth="80"
                                                    Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Sounds -->
            <Border Grid.Column="1" Margin="12,0,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sons" Style="{StaticResource Text.Title}"/>
                    <Button Grid.Row="1" Content="Adicionar som..." Margin="0,8,0,8"
                            HorizontalAlignment="Left" Command="{Binding AddSoundCommand}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sounds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="8"
                                            Background="{StaticResource CardBrush}" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Tocar" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.TestSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="X" Width="28" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemoveSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   Text="{Binding Status}"
                   Style="{StaticResource Text.Secondary}" FontSize="12"/>
    </Grid>
</UserControl>
