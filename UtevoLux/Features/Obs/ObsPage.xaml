<UserControl x:Class="UtevoLux.Features.Obs.ObsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- OBS crop guide (ported from the original OBSCropGuideDialog; collapsible) -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Fill="{StaticResource AccentBrush}"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Target}"/>
                        <TextBlock Text="Guia de Crop do OBS"
                                   Margin="10,0,0,0"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="110"
                            Content="{Binding GuideToggleText}"
                            Command="{Binding ToggleGuideCommand}"/>
                </Grid>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding GuideExpanded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Crie recortes de janelas de projetor do OBS para transmitir."
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="1. Capture o Tibia com Game Capture." FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="No OBS, adicione uma fonte Game Capture e selecione a janela do Tibia."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="2. Crie um Projetor (Projector) da Game Capture no OBS." FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Clique com o botao direito na fonte Game Capture &#8594; Filtros &#8594; Projetor (Fonte)."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="3. Use o Crop OBS e selecione a nova projecao do Tibia." FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Use o botao Adicionar recorte OBS do Utevo Lux para selecionar a janela do projetor."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="4. Recorte magias / itens etc. do projetor." FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Selecione as areas que deseja espelhar (magias, inventario, etc.) do projetor."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="5. Transmita sua segunda tela mostrando o projetor e os espelhos por cima." FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Capture sua segunda tela no OBS para mostrar o Tibia e os espelhos do Utevo Lux juntos."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Resultado" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="Os espectadores verao o Tibia e os espelhos do Utevo Lux como voce ve, mesmo estando em uma versao projetada."
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- OBS window picker -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Janela do OBS:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      DisplayMemberPath="Display"
                      VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="Atualizar" Margin="8,0,0,0" Command="{Binding RefreshSourcesCommand}"/>
            <Button Grid.Column="3" Content="Detectar OBS" Margin="8,0,0,0" Command="{Binding DetectObsCommand}"/>
        </Grid>

        <!-- Add region -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Padding="14,7"
                    Style="{StaticResource Button.Accent}"
                    Command="{Binding AddRegionCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF08131C"
                          VerticalAlignment="Center" Data="{StaticResource Icon.Add}"/>
                    <TextBlock Text="Adicionar recorte OBS" Margin="8,0,0,0" Foreground="#FF08131C"/>
                </StackPanel>
            </Button>
            <Button Content="Adicionar (loupe)" Margin="10,0,0,0" Padding="14,7"
                    Command="{Binding AddRegionLoupeCommand}"/>
        </StackPanel>

        <!-- Region list -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,6" Padding="12"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="6">
                                <StackPanel>
                                    <!-- Header row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayInfo}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="{Binding ExpandButtonText}"
                                                    MinWidth="70" Margin="4,0,0,0"
                                                    Command="{Binding ToggleExpandCommand}"/>
                                            <Button Content="{Binding VisibleButtonText}"
                                                    MinWidth="76" Margin="4,0,0,0"
                                                    Command="{Binding ToggleVisibleCommand}"/>
                                            <Button Content="{Binding LockButtonText}"
                                                    MinWidth="76" Margin="4,0,0,0"
                                                    Command="{Binding ToggleLockCommand}"/>
                                            <Button Content="Remover"
                                                    MinWidth="76" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Expandable controls -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Zoom" VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Secondary}" FontSize="12"/>
                                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="50" Maximum="400" SmallChange="5" LargeChange="25"
                                                    Value="{Binding ZoomPercent, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                       FontSize="12"
                                                       Text="{Binding ZoomPercent, StringFormat={}{0:0}%}"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Opacidade" VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Secondary}" FontSize="12"/>
                                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="15" Maximum="100" SmallChange="1" LargeChange="10"
                                                    Value="{Binding OpacityPercent, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                       FontSize="12"
                                                       Text="{Binding OpacityPercent, StringFormat={}{0:0}%}"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Escala" VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Secondary}" FontSize="12"/>
                                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="25" Maximum="400" SmallChange="5" LargeChange="25"
                                                    Value="{Binding ScalePercent, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                       FontSize="12"
                                                       Text="{Binding ScalePercent, StringFormat={}{0:0}%}"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <CheckBox Content="Passar clique direito"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      VerticalContentAlignment="Center"
                                                      IsChecked="{Binding RightClickPassthrough, Mode=TwoWay}"/>
                                            <CheckBox Content="Auto-ocultar com o OBS"
                                                      Margin="18,0,0,0"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      VerticalContentAlignment="Center"
                                                      IsChecked="{Binding AutoHide, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Refazer recorte" Margin="0,0,8,0"
                                                    Command="{Binding RecropDragCommand}"/>
                                            <Button Content="Recorte (loupe)" Margin="0,0,8,0"
                                                    Command="{Binding RecropLoupeCommand}"/>
                                            <Button Content="Novo recorte"
                                                    Command="{Binding NewCropCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="4" Margin="0,10,0,0"
                   Text="{Binding Status}"
                   Style="{StaticResource Text.Secondary}"
                   FontSize="12"/>
    </Grid>
</UserControl>
