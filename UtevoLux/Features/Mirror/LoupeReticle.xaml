<Window x:Class="UtevoLux.Features.Mirror.LoupeReticle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utevo Lux - Loupe Reticle"
        Width="360" Height="288"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

    <!-- Crosshair drawn ABOVE the loupe (a separate window, since DWM draws the loupe's
         thumbnail on top of any WPF content inside it). Transparent + click-through: purely
         cosmetic, never intercepts input. -->
    <Grid>
        <Rectangle Width="1.5"
                   HorizontalAlignment="Center" VerticalAlignment="Stretch"
                   Fill="{StaticResource AccentBrush}" Opacity="0.85"/>
        <Rectangle Height="1.5"
                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                   Fill="{StaticResource AccentBrush}" Opacity="0.85"/>
        <Ellipse Width="10" Height="10"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                 Fill="Transparent"/>
    </Grid>
</Window>
