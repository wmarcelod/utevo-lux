<Window x:Class="UtevoLux.Features.Mirror.LoupePickOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utevo Lux - Loupe Pick"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#22101820"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross">

    <!-- Transparent input surface over the source CLIENT area. It is the sole mouse sink while
         picking; the loupe + reticle float above it click-through, so clicks fall to this window.
         The dashed rectangle previews the exact fixed-box crop footprint at 1:1. -->
    <Grid>
        <Canvas x:Name="RootCanvas">
            <Rectangle x:Name="CropBox"
                       Visibility="Collapsed"
                       Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2"
                       StrokeDashArray="4 3"
                       Fill="{StaticResource AccentSoftBrush}"/>
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Background="{StaticResource OverlayBrush}"
                CornerRadius="6"
                Padding="16,10"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       FontSize="13"
                       TextAlignment="Center"
                       Text="Mova o cursor sobre a area do jogo - o loupe mostra o recorte ampliado.&#x0a;Clique confirma o recorte  -  Roda ajusta o tamanho  -  Esc cancela"/>
        </Border>
    </Grid>
</Window>
