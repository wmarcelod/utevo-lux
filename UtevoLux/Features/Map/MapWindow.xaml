<Window x:Class="UtevoLux.Features.Map.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TibiaMaps"
        Width="1000" Height="760"
        MinWidth="720" MinHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{StaticResource Font.App}">

    <!-- WindowStyle=None + AllowsTransparency=True: custom chrome, rounded corners via the
         MainBorder clip. Blue accent throughout (fork rule); the route DIRECTION colors
         (orange / green / blue) live in code and are deliberately kept as-is. -->
    <Window.Resources>

        <!-- The original's FindResource("SubtleTextColor"): a muted secondary text brush. -->
        <SolidColorBrush x:Key="SubtleTextColor" Color="{StaticResource Color.TextSecondary}"/>

        <!-- Floor-rail button: compact, transparent, hover = surface, Selected tag = accent. -->
        <Style x:Key="FloorButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF08131C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result list + item: dark surface, accent selection. -->
        <Style x:Key="ResultList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact button variant used for the route side panel. -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Item template for the "My pins" list. -->
        <DataTemplate x:Key="PinRowTemplate">
            <Border Background="#33121821" CornerRadius="4" Padding="8,6" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Tag="{Binding Id}" Cursor="Hand"
                                Background="Transparent" MouseLeftButtonUp="SavedPin_GoTo"
                                ToolTip="Click to jump to this pin">
                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource SubtleTextColor}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}, {1}  ·  floor {2}">
                                    <Binding Path="X"/>
                                    <Binding Path="Y"/>
                                    <Binding Path="Z"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="26" Height="24"
                            Tag="{Binding Id}" Click="SavedPin_Rename" ToolTip="Rename this pin">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="26" Height="24"
                            Tag="{Binding Id}" Click="SavedPin_Delete" ToolTip="Delete this pin">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Fill="{StaticResource DangerBrush}"
                              Data="M6,7 H18 V20 A1,1 0 0 1 17,21 H7 A1,1 0 0 1 6,20 Z M9,4 H15 L16,6 H20 V7 H4 V6 H8 Z"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="{StaticResource BackgroundBrush}"
            RenderTransformOrigin="0.5,0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Border.RenderTransform>
            <TranslateTransform x:Name="MainBorderTranslate" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="MainBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.05"/>
                        <DoubleAnimation Storyboard.TargetName="MainBorderTranslate"
                                         Storyboard.TargetProperty="Y"
                                         From="12" To="0" Duration="0:0:0.25" BeginTime="0:0:0.05">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ Title bar ============ -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Height="44"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF1B1F27" Offset="0"/>
                        <GradientStop Color="#FF232833" Offset="0.5"/>
                        <GradientStop Color="#FF1B1F27" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,6,0">
                        <Path Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              Fill="{StaticResource AccentBrush}"
                              Data="{StaticResource Icon.Map}"/>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
                            <Run Text="Tibia" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="Maps" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock Text="World Map" VerticalAlignment="Center" Margin="12,2,0,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Size" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="WindowScaleCombo" Width="70" FontSize="11" VerticalAlignment="Center"
                                  ToolTip="Map window size - scales the whole map window"
                                  SelectionChanged="WindowScaleCombo_SelectionChanged">
                            <ComboBoxItem Content="100%" Tag="1.0"/>
                            <ComboBoxItem Content="90%"  Tag="0.9"/>
                            <ComboBoxItem Content="80%"  Tag="0.8"/>
                            <ComboBoxItem Content="70%"  Tag="0.7"/>
                            <ComboBoxItem Content="60%"  Tag="0.6"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource Button.Icon}"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Close" Click="CloseButton_Click">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M0,0 L10,10 M10,0 L0,10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Map viewport (overlays over the canvas) ============ -->
            <Grid x:Name="MapViewport" Grid.Row="1"
                  Background="Transparent" ClipToBounds="True"
                  MouseWheel="MapViewport_MouseWheel"
                  MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                  MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                  MouseRightButtonDown="MapViewport_MouseRightButtonDown"
                  MouseRightButtonUp="MapViewport_MouseRightButtonUp"
                  MouseMove="MapViewport_MouseMove"
                  MouseLeave="MapViewport_MouseLeave">

                <!-- The single pan/zoom subject: Scale then Translate. FloorImage + RouteLayer +
                     MarkerLayer are children so they share the transform. -->
                <Canvas x:Name="MapCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="MapTranslate"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Image x:Name="FloorImage" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Canvas x:Name="RouteLayer"/>
                    <Canvas x:Name="MarkerLayer"/>
                </Canvas>

                <!-- Loading badge -->
                <Border x:Name="LoadingBadge" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#CC12151C" CornerRadius="6" Padding="14,8">
                    <TextBlock Text="Loading floor..." FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <!-- Top-left: route planner -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                        Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="RoutePlanToggle" Content="Plan Route" FontSize="12" FontWeight="Bold"
                                      ToolTip="Left-click the map to add route points; right-click removes the last one.&#x0a;Arrows show direction. Green line = going up a floor, blue = going down."
                                      Checked="RoutePlanToggle_Changed" Unchecked="RoutePlanToggle_Changed"/>
                            <TextBlock x:Name="RouteCountLabel" Margin="8,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="RoutePanel" Visibility="Collapsed" Width="216" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RouteSaveButton" Content="Save" Style="{StaticResource MiniButton}"
                                        Margin="0,0,4,0" ToolTip="Save this route so you can reload it later"
                                        Click="RouteSaveButton_Click"/>
                                <Button x:Name="RouteCopyButton" Content="Copy code" Style="{StaticResource MiniButton}"
                                        Margin="0,0,4,0" ToolTip="Copy this route as a share code"
                                        Click="RouteCopyButton_Click"/>
                                <Button x:Name="RouteClearButton" Content="Clear" Style="{StaticResource MiniButton}"
                                        ToolTip="Remove all route points" Click="RouteClearButton_Click"/>
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <ComboBox x:Name="SavedRoutesCombo" FontSize="12"
                                              ToolTip="Load a saved route"
                                              SelectionChanged="SavedRoutesCombo_SelectionChanged"/>
                                    <TextBlock x:Name="RouteComboHint" Text="No saved routes" FontSize="11"
                                               Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                                <Button x:Name="RouteDeleteButton" Grid.Column="1" Style="{StaticResource Button.Icon}"
                                        Width="28" Height="26" Margin="4,0,0,0"
                                        ToolTip="Delete the selected saved route" Click="RouteDeleteButton_Click">
                                    <Path Width="13" Height="13" Stretch="Uniform"
                                          Fill="{StaticResource DangerBrush}"
                                          Data="M6,7 H18 V20 A1,1 0 0 1 17,21 H7 A1,1 0 0 1 6,20 Z M9,4 H15 L16,6 H20 V7 H4 V6 H8 Z"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Top-right: search stack (offset left by 64 to clear the floor rail) -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,64,0" Width="250">

                    <Border Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="RareSearchToggle" Content="Creature/Rare search" FontSize="12" FontWeight="Bold"
                                      ToolTip="Show or hide the creature spawn / rare boss search"
                                      Checked="RareSearchToggle_Changed" Unchecked="RareSearchToggle_Changed"/>
                            <Grid x:Name="RareSearchPanel" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBox x:Name="RareSearchBox" FontSize="13" Padding="8,4"
                                             TextChanged="RareSearchBox_TextChanged"
                                             PreviewKeyDown="RareSearchBox_PreviewKeyDown"
                                             GotKeyboardFocus="RareSearchBox_GotKeyboardFocus"/>
                                    <TextBlock x:Name="RareSearchHint" Text="Search creature or boss..." FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                                <ListBox x:Name="RareResults" Grid.Row="1" Visibility="Collapsed" MaxHeight="240"
                                         Margin="0,6,0,0" Style="{StaticResource ResultList}"
                                         ItemContainerStyle="{StaticResource ResultItem}"
                                         MouseLeftButtonUp="RareResults_MouseLeftButtonUp"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="NpcSearchToggle" Content="NPC search" FontSize="12" FontWeight="Bold"
                                      ToolTip="Show or hide the NPC search"
                                      Checked="NpcSearchToggle_Changed" Unchecked="NpcSearchToggle_Changed"/>
                            <Grid x:Name="NpcSearchPanel" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBox x:Name="NpcSearchBox" FontSize="13" Padding="8,4"
                                             TextChanged="NpcSearchBox_TextChanged"
                                             PreviewKeyDown="NpcSearchBox_PreviewKeyDown"
                                             GotKeyboardFocus="NpcSearchBox_GotKeyboardFocus"/>
                                    <TextBlock x:Name="NpcSearchHint" Text="Search NPC..." FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                                <ListBox x:Name="NpcResults" Grid.Row="1" Visibility="Collapsed" MaxHeight="240"
                                         Margin="0,6,0,0" Style="{StaticResource ResultList}"
                                         ItemContainerStyle="{StaticResource ResultItem}"
                                         MouseLeftButtonUp="NpcResults_MouseLeftButtonUp"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <CheckBox x:Name="PinsToggle" Content="My pins" FontSize="12" FontWeight="Bold"
                                      ToolTip="Show or hide your saved pins"
                                      Checked="PinsToggle_Changed" Unchecked="PinsToggle_Changed"/>
                            <StackPanel x:Name="PinsPanel" Margin="0,8,0,0">
                                <TextBlock x:Name="PinsEmptyHint" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="No saved pins yet. Drop a pin, then press &quot;Save pin&quot;."/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="PinsList" ItemTemplate="{StaticResource PinRowTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: floor rail -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4,6" ToolTip="Scroll to change floor"
                        MouseWheel="FloorRail_MouseWheel">
                    <StackPanel>
                        <Button x:Name="FloorUpButton" Style="{StaticResource FloorButton}" Content="&#x25B2;"
                                ToolTip="Up one floor (Page Up)" Click="FloorUpButton_Click"/>
                        <ItemsControl x:Name="FloorRail"/>
                        <Button x:Name="FloorDownButton" Style="{StaticResource FloorButton}" Content="&#x25BC;"
                                ToolTip="Down one floor (Page Down)" Click="FloorDownButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Bottom-left: coordinate readout -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
                        Background="#CC1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="CoordReadout" Text="&#x2014;" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <!-- Bottom-left: creature loot panel (shown when a creature/boss is picked). Drop
                     names come from TibiaData; icons from our extracted Resources/items bank. -->
                <Border x:Name="LootPanel" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,46"
                        Width="264" MaxHeight="360"
                        Background="#EE1B1F27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="LootCreatureIcon" Grid.Column="0" Width="32" Height="32"
                                   Margin="0,0,8,0" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LootCreatureName" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LootStatus" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="LootCloseButton" Grid.Column="2" Style="{StaticResource Button.Icon}"
                                    Width="24" Height="24" VerticalAlignment="Top"
                                    ToolTip="Fechar" Click="LootCloseButton_Click">
                                <Path Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0,0 L10,10 M10,0 L0,10"/>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,6"/>
                        <ScrollViewer MaxHeight="278" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="LootGrid"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Bottom bar ============ -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Padding="20,0,20,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Height="44">
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="Right-click to drop your pin   ·   Drag map to pan   ·   Scroll to zoom"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="GoToPinButton" Content="Go to pin" FontSize="12" IsEnabled="False"
                                Margin="0,0,6,0" Style="{StaticResource MiniButton}"
                                ToolTip="Jump to your pin (switches floor if needed)" Click="GoToPinButton_Click"/>
                        <Button x:Name="SavePinButton" Content="Save pin" FontSize="12" IsEnabled="False"
                                Margin="0,0,6,0" Style="{StaticResource MiniButton}"
                                ToolTip="Give this pin a name and keep it" Click="SavePinButton_Click"/>
                        <Button x:Name="CopyCodeButton" Content="Copy code" FontSize="12" IsEnabled="False"
                                Margin="0,0,6,0" Style="{StaticResource MiniButton}"
                                ToolTip="Copy your pin as a share code" Click="CopyCodeButton_Click"/>
                        <Button x:Name="EnterCodeButton" Content="Enter code" FontSize="12"
                                Margin="0,0,14,0" Style="{StaticResource MiniButton}"
                                ToolTip="Import a pin from a share code" Click="EnterCodeButton_Click"/>
                        <TextBlock x:Name="ZoomReadout" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resize grip (bottom-right corner) -->
            <Thumb x:Name="ResizeGrip" Grid.Row="2" Grid.RowSpan="1"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="16" Height="16" Margin="0,0,4,4"
                   Cursor="SizeNWSE" Opacity="0.6" ToolTip="Drag to resize"
                   DragDelta="ResizeGrip_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Stretch="Uniform" Margin="3"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11,3 L3,11 M11,7 L7,11"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
