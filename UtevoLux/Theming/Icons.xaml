<!--
  Vector Path icon geometries (24x24 design grid). Consumed by <Path Data="{StaticResource ...}"
  Stretch="Uniform"/> so they stay crisp at any UI scale. Frozen for GPU caching.
  Feature modules expose their own Geometry (IFeatureModule.Icon); these are the shared set.

  The nav glyphs are reconstructed to visually match the original TibiaVision icon set
  (themes/tibiavisionicons.baml: Regions, Audio, Maps, Profiles, ObsTools, Settings,
  Customization, Notes, GridOverlay, TibiaVisionLink). The original draws each as a layered
  stroke+accent-dot ControlTemplate; the shell here renders a single filled Path with one brush,
  so each icon is expressed as a filled silhouette (even-odd / F1 non-zero cut-outs give the
  outline look). Resource KEYS are unchanged so the shell + modules keep resolving.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ===== Nav glyphs (match the original TibiaVision set) ===== -->

    <!-- Mirror / Regions: viewfinder corner brackets around a lens dot -->
