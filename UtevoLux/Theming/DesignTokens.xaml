<!--
  DesignTokens: the single source of truth for the dark palette + one accent color.
  Only raw Color values and the accent live here. Named frozen brushes are derived in
  Brushes.xaml. Code-built windows read these by key with hardcoded fallbacks.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Palette (dark) ===== -->
    <Color x:Key="Color.Background">#FF12151C</Color>
    <Color x:Key="Color.Surface">#FF1B1F27</Color>
    <Color x:Key="Color.SurfaceAlt">#FF232833</Color>
    <Color x:Key="Color.Card">#FF2C3340</Color>
    <Color x:Key="Color.CardHover">#FF343C4B</Color>
    <Color x:Key="Color.Border">#FF333A47</Color>
    <Color x:Key="Color.BorderStrong">#FF454E5E</Color>

    <Color x:Key="Color.TextPrimary">#FFF3F5F9</Color>
    <Color x:Key="Color.TextSecondary">#FF9AA4B3</Color>
    <Color x:Key="Color.TextMuted">#FF69707D</Color>

    <!-- One accent brush color + its pressed variant -->
    <Color x:Key="Color.Accent">#FF3FA9F5</Color>
    <Color x:Key="Color.AccentPressed">#FF2E86C6</Color>
    <Color x:Key="Color.AccentSoft">#553FA9F5</Color>

    <Color x:Key="Color.Danger">#FFE5534B</Color>
    <Color x:Key="Color.Success">#FF3FB950</Color>
    <Color x:Key="Color.Warning">#FFD8A24A</Color>

    <Color x:Key="Color.Overlay">#CC000000</Color>
    <Color x:Key="Color.ScrimTop">#33101820</Color>

    <!-- ===== Metrics / typography tokens ===== -->
    <!--
      Font: a fallback chain that resolves on every Win10/11 box. This is the "embed slot":
      to ship a bundled face, drop the .ttf under Assets/Fonts and change this to
      "/UtevoLux;component/Assets/Fonts/#<Family>". No binary font is bundled here
      (none available to embed cleanly), so a robust system stack stands in.
    -->
    <FontFamily x:Key="Font.App">Segoe UI Variable Text, Segoe UI, Tahoma, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, sans-serif</FontFamily>

    <sys:Double x:Key="Radius.Window">10</sys:Double>
    <sys:Double x:Key="Radius.Card">6</sys:Double>
    <sys:Double x:Key="Radius.Control">4</sys:Double>

</ResourceDictionary>
